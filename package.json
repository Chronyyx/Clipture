{
  "name": "clipture",
  "version": "1.5.0",
  "private": true,
  "description": "Low-footprint Tauri desktop client for the native Clipture capture engine.",
  "releaseTitle": "Clipture 1.5.0: Native Tauri 2 Architecture & Ultra-Low Footprint",
  "main": "dist/main/main.js",
  "author": "Clipture",
  "scripts": {
    "tauri": "tauri",
    "dev:web": "vite --host 127.0.0.1",
    "build:renderer": "tsc --noEmit && vite build",
    "stage:tauri": "node scripts/stage-tauri-sidecars.cjs",
    "dev:tauri": "npm run build:engine && npm run stage:tauri && tauri dev",
    "build:tauri": "npm run build:engine && npm run stage:tauri && npm run build:renderer && tauri build --no-bundle && node scripts/stage-tauri-app.cjs",
    "dev": "npm run dev:tauri",
    "build": "npm run build:tauri",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:ui": "npm run build:renderer",
    "build:engine": "cmake -S engine -B build/engine -A x64 && cmake --build build/engine --config Release",
    "pack:win": "npm run build:tauri",
    "dist:win": "npm run build:tauri && tauri bundle --bundles nsis",
    "typecheck": "tsc --noEmit",
    "test:frame-diagnostics": "npm run build:electron && node scripts/test-frame-drop-diagnostics.cjs",
    "test:update-transfer": "npm run build:electron && node scripts/test-update-transfer.cjs",
    "start:dev": "npm run dev:tauri",
    "start:built": "node scripts/run-tauri.cjs",
    "start:packaged": "npm run pack:win && npm run start:built",
    "start": "npm run build && npm run start:built",
    "dev:legacy": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/run-electron.cjs .\"",
    "build:legacy": "npm run build:engine && npm run build:electron && npm run build:renderer",
    "pack:legacy": "npm run build:legacy && electron-builder --win --x64 --dir",
    "dist:legacy": "npm run build:legacy && electron-builder --win --x64",
    "start:legacy": "npm run build:legacy && node scripts/run-electron.cjs ."
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-rnnoise-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.clipture.desktop",
    "productName": "Clipture",
    "executableName": "Clipture",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Chronyyx",
        "repo": "Clipture"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "build/engine/Release/clipture_engine.exe",
        "to": "engine/clipture_engine.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Clipture-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clipture"
    }
  }
}
